generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categories {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)
}

model comments {
  id          Int       @id @default(autoincrement())
  customer_id Int
  title       String    @db.VarChar(200)
  description String?   @db.Text
  customers   customers @relation(fields: [customer_id], references: [id])

  @@index([customer_id], map: "comments_customer_id_fkey")
}

model customers {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  phone     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime
  comments  comments[]
  likes     likes[]
  wallets   Wallets?
  products  products[] @relation("loves")
}

model likes {
  customer_id Int
  product_id  String    @db.VarChar(100)
  customers   customers @relation(fields: [customer_id], references: [id])
  products    products  @relation(fields: [product_id], references: [id])

  @@id([customer_id, product_id])
  @@index([product_id], map: "likes_product_id_fkey")
}

model products {
  id        String      @id
  name      String
  price     Int
  stock     Int
  category  String
  likes     likes[]
  customers customers[] @relation("loves")
}

model sample {
  id               Int     @id @default(autoincrement())
  name             String  @db.VarChar(100)
  description      String? @db.Text
  full_description String? @db.Text
}

model Wallets {
  id          Int       @id @default(autoincrement())
  balance     Int
  customer_id Int       @unique
  customers   customers @relation(fields: [customer_id], references: [id])

  @@map("wallets")
}
